{
  "manifest_version": 3,
  "name": "AI Email Agent for Gmail",
  "version": "0.1.0",
  "description": "The AI Email Agent assistant in a side panel next to Gmail.",
  "key": "",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Email Agent"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "name": "ai-email-agent-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm run build && node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "TEST_DATABASE_URL=postgres://ai_email:ai_email@localhost:5434/ai_email vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm run build && node dist/cli/migrate.js",
    "doctor": "pnpm run build && node dist/cli/doctor.js",
    "auth": "pnpm run build && node dist/cli/auth.js",
    "sync": "pnpm run build && node dist/cli/sync.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "10.1.6",
    "@google/genai": "2.30.0",
    "@googleapis/docs": "14.1.1",
    "@googleapis/drive": "26.0.2",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/sheets": "18.1.1",
    "@googleapis/tasks": "^17.0.1",
    "addressparser": "^1.0.1",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "kysely": "0.29.7",
    "mammoth": "1.13.0",
    "nodemailer": "^10.1.7",
    "open": "^11.0.4",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "read-excel-file": "9.3.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/addressparser": "^1.0.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jszip": "3.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}

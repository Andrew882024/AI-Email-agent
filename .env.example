# Copy to .env and fill in.

# Google OAuth (GCP "Desktop app" OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres + pgvector (docker compose maps to host port 5434 by default)
DATABASE_URL=postgres://ai_email:ai_email@localhost:5434/ai_email

# Backend HTTP port
SERVER_PORT=4317
# Extra browser origins allowed to call the API (comma-separated; e.g. the Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local app files (logs, uploads). Defaults to ~/.ai-email-agent
APP_DATA_DIR=

# Full sync covers the last N days of mail (0 = whole mailbox); poll Gmail every N seconds
SYNC_WINDOW_DAYS=365
SYNC_POLL_SECONDS=30
# Your GCP project's Gmail "units per minute per user" quota (APIs & Services → Gmail API → Quotas)
GMAIL_QUOTA_UNITS_PER_MINUTE=15000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Used from Phase 2 (token encryption outside Electron) and Phase 7 (LLM)
APP_SECRET_KEY=
GEMINI_API_KEY=

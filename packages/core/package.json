{
  "name": "@ai-email/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "pnpm run build && node dist/cli/doctor.js",
    "migrate": "pnpm run build && node dist/cli/migrate.js",
    "auth": "pnpm run build && node dist/cli/auth.js",
    "sync": "pnpm run build && node dist/cli/sync.js"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/tasks": "^17.0.1",
    "addressparser": "^1.0.1",
    "google-auth-library": "^11.3.1",
    "kysely": "0.29.7",
    "nodemailer": "^10.1.7",
    "open": "^11.0.4",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/addressparser": "^1.0.3",
    "@types/pg": "^8.23.1"
  }
}
